               Fill="{DynamicResource ColorBrush2}" Opacity="0.7" Width="40" Stretch="Uniform"
              Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="4,0,0,0" />
        <local:MyButton x:Name="BtnOAuth" Text="{DynamicResource Launch.Account.Auth.OAuthLogin}"
                        ColorType="Highlight" Height="28" Width="120" Grid.Row="2" Grid.ColumnSpan="2"
                        HorizontalAlignment="Center" />
        <Grid Grid.Row="4" Grid.ColumnSpan="2" Opacity="0.3" Margin="2,30,2,0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:MyTextButton x:Name="BtnWebsite" Text="{DynamicResource Launch.Account.Microsoft.Website}"
                                Grid.Column="0" />
            <local:MyTextButton x:Name="BtnUsePassword" Text="{DynamicResource Launch.Account.Auth.UsePassword}"
                                Grid.Column="2" />
        </Grid>
    </Grid>
    <local:MyTextBox Grid.Row="4" Grid.Column="1" Height="28" x:Name="TextName" />
    <TextBlock x:Name="TextNameTitle" Text="{DynamicResource Launch.Account.Auth.Email}" Grid.Row="4" VerticalAlignment="Center" />
    <PasswordBox Grid.Row="6" Grid.Column="1" x:Name="TextPass" />
    <TextBlock x:Name="TextPassTitle" Text="{DynamicResource Launch.Account.Auth.Password}" Grid.Row="6" VerticalAlignment="Center" />
    <local:MyTextButton Margin="0,12,2,0" x:Name="BtnLink" Content="{DynamicResource Launch.Account.Auth.Register}"
                        Grid.Row="7" HorizontalAlignment="Right"
                        Grid.Column="1" Padding="20,0,0,0" HorizontalContentAlignment="Right" FontSize="13"
                        VerticalContentAlignment="Center" Visibility="Collapsed" />
    <Grid x:Name="PanPasswordLinks" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
          Opacity="0.3" Margin="2,20,2,0" HorizontalAlignment="Center" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <local:MyTextButton x:Name="BtnPasswordWebsite" Text="{DynamicResource Launch.Account.Microsoft.Website}"
                            Grid.Column="0" />
        <local:MyTextButton x:Name="BtnUseOAuth" Text="{DynamicResource Launch.Account.Auth.UseOAuth}"
                            Grid.Column="2" />
    </Grid>
    <local:MyButton x:Name="BtnBack" Grid.Row="9" Grid.Column="1" Width="50" Margin="-100,0,0,0" ColorType="Normal"
                    Text="{DynamicResource Launch.Account.Auth.Back}" HorizontalAlignment="Center" />
    <local:MyTextButton x:Name="BtnBackOAuth" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                        Margin="0" Text="{DynamicResource Launch.Account.Back}"
                        HorizontalAlignment="Center" Opacity="0.3" Visibility="Collapsed" />
    <local:MyButton x:Name="BtnLogin" Grid.Row="9" Grid.Column="1" Width="50" Margin="20,0,0,0" ColorType="Highlight"
                    Text="{DynamicResource Launch.Account.Auth.Login}" HorizontalAlignment="Center" />
</Grid>
