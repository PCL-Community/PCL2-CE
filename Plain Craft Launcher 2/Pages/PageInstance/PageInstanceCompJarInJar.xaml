<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageInstanceCompJarInJar"
    PanScroll="{Binding ElementName=PanBack}">
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              x:Name="PanBack">
            <StackPanel x:Name="PanMain" Margin="25,10,25,10">
                <local:MyCard Margin="0,15,0,15" x:Name="PanManage">
                    <WrapPanel Margin="15,8,0,15">
                        <local:MyButton x:Name="BtnBack" MinWidth="110"
                                        Text="{DynamicResource Instance.Resource.BackToParent}" Padding="13,7"
                                        Margin="0,7,15,0" HorizontalAlignment="Left" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnRefresh" MinWidth="110"
                                        Text="{DynamicResource Common.Action.Refresh}" Padding="13,7"
                                        Margin="0,7,15,0" HorizontalAlignment="Left" />
                        <TextBlock VerticalAlignment="Center" Margin="0,7,15,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="{DynamicResource Instance.Resource.Mod.JarInJar.Message}" />
                    </WrapPanel>
                </local:MyCard>

                <local:MySearchBox Margin="0,0,0,15" x:Name="SearchBox"
                                   HintText="{DynamicResource Instance.Resource.Mod.JarInJar.Search.Hint}" />

                <!-- 警告板块 -->
                <local:MyCard x:Name="CardWarnings" Margin="0,0,0,15">
                    <StackPanel Margin="15,10,15,12">
                        <TextBlock Text="{DynamicResource Instance.Resource.Mod.JarInJar.Section.Warnings}"
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}" />
                        <StackPanel x:Name="PanWarnList" Margin="0,8,0,0" />
                    </StackPanel>
                </local:MyCard>

                <!-- 冲突关系板块 -->
                <local:MyCard x:Name="CardConflicts" Margin="0,0,0,15">
                    <StackPanel Margin="15,10,15,12">
                        <TextBlock Text="{DynamicResource Instance.Resource.Mod.JarInJar.Section.Conflicts}"
                                   ToolTip="{DynamicResource Instance.Resource.Mod.JarInJar.Conflict.Tooltip}"
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}" />
                        <StackPanel x:Name="PanConflictList" Margin="0,8,0,0" />
                    </StackPanel>
                </local:MyCard>

                <!-- 模组关系板块 -->
                <StackPanel x:Name="SectionRelations">
                    <TextBlock Text="{DynamicResource Instance.Resource.Mod.JarInJar.Section.Relations}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}"
                               Margin="2,0,0,8" />
                    <StackPanel x:Name="PanRelationList" />
                </StackPanel>

                <!-- 内嵌模组板块 -->
                <StackPanel x:Name="SectionBundled">
                    <TextBlock Text="{DynamicResource Instance.Resource.Mod.JarInJar.Section.Bundled}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}"
                               Margin="2,4,0,8" />
                    <StackPanel x:Name="PanBundledList" />
                </StackPanel>
            </StackPanel>
        </local:MyScrollViewer>
        <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" x:Name="PanEmpty"
                      Visibility="Collapsed">
            <StackPanel Margin="20,17">
                <TextBlock Margin="0,0,0,9" HorizontalAlignment="Center"
                           Text="{DynamicResource Instance.Resource.Mod.JarInJar.Empty.Title}" FontSize="19"
                           UseLayoutRounding="True" SnapsToDevicePixels="True"
                           Foreground="{DynamicResource ColorBrush3}" />
                <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                <TextBlock Margin="10,10,10,0" Text="{DynamicResource Instance.Resource.Mod.JarInJar.Empty.Message}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" />
                <local:MyButton Height="35" x:Name="BtnEmptyBack" MinWidth="130"
                                Text="{DynamicResource Instance.Resource.BackToParent}" Margin="5,20,5,5"
                                Padding="12,0" HorizontalAlignment="Center" ColorType="Highlight" />
            </StackPanel>
        </local:MyCard>
        <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0" SnapsToDevicePixels="True"
                      x:Name="PanLoad" UseAnimation="False">
            <local:MyLoading Text="{DynamicResource Instance.Resource.Loading}" Margin="20,20,20,17" x:Name="Load"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
        </local:MyCard>
    </Grid>
</local:MyPageRight>
